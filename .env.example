# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
DISCORD_TOKEN=

# ---------------------------------------------------------------------------
# Scoping. EVERY ONE OF THESE FAILS CLOSED: blank or unset means deny, not
# allow-all. A typo silences the bot rather than widening it.
# Reloadable at runtime with /reload -- no restart needed.
# ---------------------------------------------------------------------------

# Guild (server) IDs. Events from anywhere else are ignored, and slash commands
# are registered only to these guilds.
GUILD_ALLOWLIST=

# Voice channel IDs the bot may occupy. Being dragged into any other channel
# causes an immediate disconnect.
VOICE_CHANNEL_ALLOWLIST=

# voice_channel_id:text_channel_id pairs. The bot refuses to join a voice
# channel with no bound text channel, because that channel is the source of
# truth for the conversation.
#
# To use the voice channel's own built-in chat (Discord's Text-in-Voice), give
# the same ID on both sides -- that chat's channel ID *is* the voice channel's:
#   TEXT_CHANNEL_BINDING=1544378611170025583:1544378611170025583
TEXT_CHANNEL_BINDING=

# User IDs whose speech is transcribed. Everyone else's audio is dropped at the
# sink, before decryption -- it never reaches a decoder, a buffer, or the GPU.
USER_ALLOWLIST=

# Join an allowlisted channel when an allowlisted user enters; leave when the
# last one goes.
AUTO_JOIN=false

# ---------------------------------------------------------------------------
# Turn logic
# ---------------------------------------------------------------------------
WAKE_MODE=always            # always | wakeword | ptt
WAKE_WORD=claude
ENDPOINT_SILENCE_MS=700     # trailing silence that ends a turn
MIN_UTTERANCE_MS=300        # anything shorter is discarded as noise
MAX_UTTERANCE_MS=30000
VAD_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# ASR
# ---------------------------------------------------------------------------
# nemo_unified -> nvidia/parakeet-unified-en-0.6b   (needs the [nemo] extra)
# hf_tdt       -> nvidia/parakeet-tdt-0.6b-v3       (needs the [hf] extra)
ASR_BACKEND=nemo_unified
ASR_MODEL_ID=nvidia/parakeet-unified-en-0.6b
ASR_DEVICE=cuda

# ---------------------------------------------------------------------------
# TTS
# ---------------------------------------------------------------------------
TTS_VOICE=af_heart
TTS_LANG_CODE=a             # a = American English
TTS_SPEED=1.0
TTS_ENABLED=true

# Spoken replies are capped here; the full output always goes to the bound
# text channel untruncated.
SPEAK_CHAR_LIMIT=600

# ---------------------------------------------------------------------------
# Claude Code bridge
# ---------------------------------------------------------------------------
# headless -> `claude -p --output-format stream-json` (default; structured
#             permission and rate-limit events)
# tmux     -> inject into your existing interactive session (drives the session
#             you are looking at, but permission and rate-limit detection are
#             heuristic because it only sees rendered text)
CLAUDE_BRIDGE=headless

# Required when CLAUDE_BRIDGE=tmux. Find it with `tmux ls`.
TMUX_SESSION=

CLAUDE_BINARY=claude
CLAUDE_CWD=                 # working directory for headless turns; blank = cwd
CLAUDE_PERMISSION_MODE=default

TMUX_POLL_INTERVAL_MS=250
TMUX_IDLE_SETTLE_MS=1200

# ---------------------------------------------------------------------------
# Ops
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO              # DEBUG prints per-stage turn latencies

# ---------------------------------------------------------------------------
# DO NOT SET THESE. Each one outranks your subscription login and would move
# billing to metered API usage. They are stripped from every subprocess the bot
# starts, and their presence in a tmux session is a startup error:
#   ANTHROPIC_API_KEY  ANTHROPIC_AUTH_TOKEN  CLAUDE_CODE_USE_BEDROCK
#   CLAUDE_CODE_USE_VERTEX  CLAUDE_CODE_USE_FOUNDRY  ANTHROPIC_PROFILE
#   ANTHROPIC_FEDERATION_RULE_ID  ANTHROPIC_ORGANIZATION_ID
#
# CLAUDE_CODE_OAUTH_TOKEN is fine -- it is a subscription credential from
# `claude setup-token`, and it is deliberately not stripped.
# ---------------------------------------------------------------------------
